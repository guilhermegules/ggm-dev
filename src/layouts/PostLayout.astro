---
import BaseHead from "@components/BaseHead.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---

<!doctype html>
<html lang="pt-br" data-accent="mint">
  <head>
    <BaseHead title={`${title} • Guilherme Gules`} description={description} image={heroImage} />
  </head>

  <body class="cin-body flex flex-col min-h-screen">
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-8">
      <div class="mb-4">
        <a href="/blog" class="cin-btn py-2 px-3 text-xs inline-flex items-center gap-1.5">
          &larr; Voltar para os artigos
        </a>
      </div>

      <article class="cin-window-card">
        <header class="cin-titlebar">
          <div class="cin-titlebar-left">
            <span class="cin-titlebar-icon">📄</span>
          </div>
          <div class="cin-titlebar-center">
            <span class="cin-titlebar-title truncate max-w-xs sm:max-w-md">{title}</span>
          </div>
          <div class="cin-titlebar-right">
            <div class="cin-window-controls hidden sm:flex">
              <button class="cin-win-btn cin-win-btn-min" type="button" aria-label="Minimizar">
                <svg viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6"></line></svg>
              </button>
              <button class="cin-win-btn cin-win-btn-max" type="button" aria-label="Maximizar">
                <svg viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" rx="1" fill="none"></rect></svg>
              </button>
              <button class="cin-win-btn cin-win-btn-close" type="button" aria-label="Fechar">
                <svg viewBox="0 0 12 12"><path d="M3 3L9 9M9 3L3 9"></path></svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Hero Image -->
        {heroImage && (
          <div class="w-full bg-[var(--cin-bg-alt)] border-b border-[var(--cin-separator)] overflow-hidden">
            <img
              width={1020}
              height={510}
              src={heroImage}
              alt=""
              class="w-full max-h-96 object-cover"
            />
          </div>
        )}

        <!-- Article Content -->
        <div class="p-6 md:p-10 bg-[var(--cin-bg-base)]">
          <header class="mb-8 pb-6 border-b border-[var(--cin-separator)]">
            <div class="flex items-center gap-2 mb-3">
              <span class="cin-badge">{formatDate(pubDate)}</span>
              {updatedDate && (
                <span class="text-xs text-[var(--cin-fg-subtle)] italic">
                  (Atualizado em {formatDate(updatedDate)})
                </span>
              )}
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight mb-3">{title}</h1>
            {description && (
              <p class="text-base sm:text-lg text-[var(--cin-fg-dim)] m-0 leading-relaxed">
                {description}
              </p>
            )}
          </header>

          <div class="prose cin-markdown-body max-w-none text-base leading-relaxed">
            <slot />
          </div>

          <footer class="mt-8 pt-4 border-t border-[var(--cin-separator)]">
            <span class="text-xs text-[var(--cin-fg-subtle)]">
              Escrito por Guilherme Gules Moreira
            </span>
          </footer>
        </div>
      </article>

      <slot name="comments" />
    </main>
  </body>
</html>