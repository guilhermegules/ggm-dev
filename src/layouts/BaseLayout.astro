---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description: string;
  footer?: {
    isFixed?: boolean;
  };
}

const { title, description, footer } = Astro.props;
---

<!doctype html>
<html lang="pt-br" data-accent="mint">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="cin-body flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <slot />
    </main>
    <Footer isFooterFixed={footer?.isFixed} />
  </body>
</html>
