---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "@layouts/BlogPost.astro";
import { render } from "astro:content";
import Giscus from "@components/Giscus";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
  <Content />
  <section class="mt-12 pt-8 border-t border-[var(--cin-separator)]">
    <div class="flex items-center gap-2 mb-6">
      <span class="text-xl">💬</span>
      <h3 class="text-xl font-bold m-0 text-[var(--cin-fg-base)]">Comentários</h3>
    </div>
    <div class="cin-box p-4 md:p-6 bg-[var(--cin-bg-surface)] rounded-lg">
      <Giscus client:visible />
    </div>
  </section>
</BlogPost>
