---
import BaseHead from "@components/BaseHead.astro";
import { SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import CinnamonDesktop from "@components/desktop/CinnamonDesktop";

let posts: any[] = [];
try {
    posts = (await getCollection("blog"))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .map((post) => ({
            id: post.id,
            title: post.data.title,
            description: post.data.description,
            pubDate: post.data.pubDate.toLocaleDateString("pt-BR", {
                day: "2-digit",
                month: "short",
                year: "numeric",
            }),
            heroImage: post.data.heroImage,
            body: post.body,
        }));
} catch {
    posts = [];
}
---

<!doctype html>
<html lang="pt-br" data-accent="mint" class="h-full overflow-hidden">
    <head>
        <BaseHead
            title="Sobre Mim • Guilherme Gules"
            description={SITE_DESCRIPTION}
        />
    </head>
    <body class="cin-body h-full overflow-hidden m-0 p-0">
        <CinnamonDesktop client:load posts={posts} initialWindow="about" />

        <div class="sr-only">
            <h1>Sobre Mim - Guilherme Gules Moreira</h1>
            <p>
                Desenvolvedor de Software Full Stack, apaixonado por
                arquiteturas modernas como Microfrontends e BFFs.
            </p>
            <a href="/files/curriculo-guilhermegulesmoreira.pdf">
                Baixar Currículo
            </a>
        </div>
    </body>
</html>
