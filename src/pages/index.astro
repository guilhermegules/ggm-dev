---
import BaseHead from "@components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import CinnamonDesktop from "@components/desktop/CinnamonDesktop";

let posts: any[] = [];
try {
  posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((post) => ({
      id: post.id,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate.toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }),
      heroImage: post.data.heroImage,
      body: post.body,
    }));
} catch {
  posts = [];
}
---

<!doctype html>
<html lang="pt-br" data-accent="mint" class="h-full overflow-hidden">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="cin-body h-full overflow-hidden m-0 p-0">
    <CinnamonDesktop client:load posts={posts} />

    {/* Semantic SEO and Crawler Fallback */}
    <div class="sr-only">
      <h1>Guilherme Gules Moreira</h1>
      <p>{SITE_DESCRIPTION}</p>
      <h2>Artigos do Blog</h2>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.title}</a>
            <p>{post.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </body>
</html>
