---
import BaseHead from "@components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection, type CollectionEntry } from "astro:content";
import type { BlogPostData } from "@components/desktop/types";
import CinnamonDesktop from "@components/desktop/CinnamonDesktop";

let rawPosts: CollectionEntry<"blog">[] = [];
try {
  rawPosts = await getCollection("blog");
} catch {
  rawPosts = [];
}

const posts: BlogPostData[] = rawPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate.toLocaleDateString("pt-BR", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    }),
    heroImage: post.data.heroImage,
    body: post.body,
    html: post.rendered?.html,
  }));
---

<!doctype html>
<html lang="pt-br" data-accent="mint" class="h-full overflow-hidden">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="cin-body h-full overflow-hidden m-0 p-0">
    <CinnamonDesktop client:load posts={posts} />

    <div class="sr-only">
      <h1>Guilherme Gules Moreira</h1>
      <p>{SITE_DESCRIPTION}</p>
      <h2>Artigos do Blog</h2>
      <ul>
        {
          posts.map((post) => (
            <li>
              <span>{post.title}</span>
              <p>{post.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </body>
</html>
