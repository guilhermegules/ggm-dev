---
import type { InferEntrySchema, RenderedContent } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: {
    id: string;
    body?: string;
    collection: "blog";
    data: InferEntrySchema<"blog">;
    rendered?: RenderedContent;
    filePath?: string;
  }[];
  isAllCardsSmall?: boolean;
}

const { posts, isAllCardsSmall = false } = Astro.props;
---

<div class="cin-posts-grid">
  {
    posts.map((post, index) => (
      <article
        class:list={[
          "cin-box cin-post-card",
          { "is-featured": !isAllCardsSmall && index === 0 },
        ]}
      >
        <a href={`/blog/${post.id}/`} class="cin-post-link">
          {post.data.heroImage && (
            <div class="cin-post-img-container">
              <img
                width={720}
                height={360}
                src={post.data.heroImage}
                alt={post.data.description || post.data.title}
                class="cin-post-img"
              />
            </div>
          )}
          <div class="cin-post-content">
            <div class="cin-post-meta">
              <span class="cin-badge">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>
            <h3 class="cin-post-title">{post.data.title}</h3>
            {post.data.description && (
              <p class="cin-post-desc">{post.data.description}</p>
            )}
            <div class="cin-post-footer">
              <span class="cin-post-read-more">Ler artigo &rarr;</span>
            </div>
          </div>
        </a>
      </article>
    ))
  }
</div>

<style>
  .cin-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .cin-post-card {
    border-radius: var(--cin-radius-lg);
    background-color: var(--cin-bg-surface);
    border: 1px solid var(--cin-border);
    box-shadow: var(--cin-shadow-sm);
    overflow: hidden;
    transition: transform var(--cin-transition-normal), 
                box-shadow var(--cin-transition-normal), 
                border-color var(--cin-transition-normal);
    display: flex;
    flex-direction: column;
  }

  .cin-post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--cin-shadow-md);
    border-color: var(--cin-accent);
  }

  .cin-post-card.is-featured {
    grid-column: 1 / -1;
  }

  .cin-post-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cin-post-img-container {
    width: 100%;
    overflow: hidden;
    background-color: var(--cin-bg-alt);
    border-bottom: 1px solid var(--cin-separator);
  }

  .cin-post-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: transform var(--cin-transition-normal);
  }

  .is-featured .cin-post-img {
    height: 280px;
  }

  .cin-post-card:hover .cin-post-img {
    transform: scale(1.02);
  }

  .cin-post-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-1;
    gap: 0.6rem;
  }

  .cin-post-meta {
    display: flex;
    align-items: center;
  }

  .cin-post-title {
    margin: 0;
    font-size: var(--cin-text-lg);
    font-weight: var(--cin-font-bold);
    color: var(--cin-fg-base);
    line-height: 1.3;
    transition: color var(--cin-transition-fast);
  }

  .is-featured .cin-post-title {
    font-size: 1.5rem;
  }

  .cin-post-card:hover .cin-post-title {
    color: var(--cin-accent);
  }

  .cin-post-desc {
    margin: 0;
    font-size: var(--cin-text-base);
    color: var(--cin-fg-dim);
    line-height: 1.5;
    flex-1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cin-post-footer {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--cin-separator);
  }

  .cin-post-read-more {
    font-size: var(--cin-text-sm);
    font-weight: var(--cin-font-bold);
    color: var(--cin-accent);
  }

  @media (max-width: 640px) {
    .cin-posts-grid {
      grid-template-columns: 1fr;
    }
    .cin-post-img {
      height: 160px;
    }
    .is-featured .cin-post-img {
      height: 180px;
    }
  }
</style>
