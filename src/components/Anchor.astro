---
interface Props {
  href: string;
  download?: boolean | string;
  className?: string;
  isOutline?: boolean;
  target?: astroHTML.JSX.HTMLAttributeAnchorTarget;
}

const { href, download, className = "", isOutline = false, target } = Astro.props;
---

<a
  href={href}
  class:list={[
    "cin-btn cin-btn-lg transition-all",
    isOutline ? "" : "cin-btn-suggested",
    className
  ]}
  download={download}
  target={target}
>
  <slot />
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: var(--cin-font-bold);
  }
</style>
