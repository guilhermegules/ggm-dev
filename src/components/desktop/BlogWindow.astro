---
import type { BlogPostData } from "./types";

interface Props {
  posts: BlogPostData[];
}

const { posts } = Astro.props;
---

<cin-blog-window class="flex flex-col h-full bg-[var(--cin-bg-base)] text-[var(--cin-fg-base)] overflow-hidden">
  <div class="p-3 border-b border-[var(--cin-separator)] bg-[var(--cin-bg-surface)] flex items-center justify-between gap-4 flex-shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-xl">📚</span>
      <span class="text-sm font-bold">Explorador de Artigos</span>
      <span class="cin-badge" data-blog-win-count>{posts.length} artigos</span>
    </div>

    <div class="cin-search-box max-w-xs w-full">
      <span class="cin-search-icon">🔍</span>
      <input
        type="text"
        class="cin-input"
        placeholder="Filtrar artigos..."
        data-blog-win-search
      />
    </div>
  </div>

  <div class="flex-1 overflow-y-auto p-4 md:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-blog-win-grid>
      {
        posts.map((post) => (
          <div
            data-blog-win-card
            data-open-post-id={post.id}
            data-search-text={`${post.title} ${post.description} ${post.id}`.toLowerCase()}
            class="cin-box p-4 flex flex-col justify-between cursor-pointer hover:border-[var(--cin-accent)] transition-all hover:-translate-y-1 hover:shadow-md bg-[var(--cin-bg-surface)] rounded-lg group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="cin-badge">{post.pubDate}</span>
                <span class="text-xs text-[var(--cin-fg-dim)] font-mono">{post.id}</span>
              </div>
              <h3 class="text-base font-bold text-[var(--cin-fg-base)] group-hover:text-[var(--cin-accent)] transition-colors line-clamp-2 mb-2">
                {post.title}
              </h3>
              <p class="text-xs text-[var(--cin-fg-dim)] line-clamp-3 leading-relaxed m-0">
                {post.description}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-[var(--cin-separator)] flex items-center justify-between">
              <span class="text-xs font-bold text-[var(--cin-accent)]">
                Abrir janela do artigo &rarr;
              </span>
              <span class="text-xs text-[var(--cin-fg-subtle)]">Document Viewer</span>
            </div>
          </div>
        ))
      }
    </div>

    <div
      data-blog-win-empty
      class:list={[
        "text-center py-12 text-[var(--cin-fg-dim)]",
        { hidden: posts.length > 0 },
      ]}
    >
      <p>
        Nenhum artigo encontrado para "<span data-blog-win-query></span>".
      </p>
    </div>
  </div>

  <div class="cin-window-statusbar flex-shrink-0 text-xs px-3 py-1 bg-[var(--cin-bg-surface)] border-t border-[var(--cin-separator)] text-[var(--cin-fg-dim)] flex justify-between">
    <span>Total: {posts.length} artigos carregados</span>
    <span>Clique em qualquer artigo para abrir em uma janela separada</span>
  </div>
</cin-blog-window>

<script>
  class CinBlogWindowElement extends HTMLElement {
    private handleInput = (e: Event) => {
      const target = e.target as HTMLInputElement;
      if (!target.matches("[data-blog-win-search]")) return;

      const rawQuery = target.value;
      const normalized = rawQuery.trim().toLowerCase();
      const cards = Array.from(this.querySelectorAll<HTMLElement>("[data-blog-win-card]"));
      const countBadge = this.querySelector<HTMLElement>("[data-blog-win-count]");
      const emptyBox = this.querySelector<HTMLElement>("[data-blog-win-empty]");
      const querySpan = this.querySelector<HTMLElement>("[data-blog-win-query]");

      let visibleCount = 0;
      cards.forEach((card) => {
        const text = card.dataset.searchText || "";
        const matches = !normalized || text.includes(normalized);
        card.classList.toggle("hidden", !matches);
        if (matches) visibleCount++;
      });

      if (countBadge) {
        countBadge.textContent = `${visibleCount} artigos`;
      }
      if (querySpan) {
        querySpan.textContent = rawQuery;
      }
      if (emptyBox) {
        emptyBox.classList.toggle("hidden", visibleCount > 0);
      }
    };

    connectedCallback() {
      this.addEventListener("input", this.handleInput);
    }

    disconnectedCallback() {
      this.removeEventListener("input", this.handleInput);
    }
  }

  if (typeof window !== "undefined" && !customElements.get("cin-blog-window")) {
    customElements.define("cin-blog-window", CinBlogWindowElement);
  }
</script>
