---
interface Props {
  icon: string;
  label: string;
  windowId?: string;
  href?: string;
  download?: boolean;
  title?: string;
}

const { icon, label, windowId, href, download, title } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      download={download ? true : undefined}
      class="cin-desktop-icon no-underline"
      title={title || label}
    >
      <div class="cin-desktop-icon-img text-3xl">{icon}</div>
      <div class="cin-desktop-icon-label">{label}</div>
    </a>
  ) : (
    <button
      type="button"
      data-window-id={windowId}
      class="cin-desktop-icon bg-transparent border-0 cursor-pointer text-inherit p-0"
      title={title || `Clique para abrir ${label}`}
    >
      <div class="cin-desktop-icon-img text-3xl">{icon}</div>
      <div class="cin-desktop-icon-label">{label}</div>
    </button>
  )
}
