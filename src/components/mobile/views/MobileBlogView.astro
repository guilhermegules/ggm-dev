---
import type { BlogPostData } from "../../desktop/types";

interface Props {
  posts: BlogPostData[];
}

const { posts } = Astro.props;
---

<div class="space-y-4 pb-24" data-mobile-blog-view>
  <div class="cin-box p-4 rounded-2xl bg-[var(--cin-bg-surface)] border border-[var(--cin-border)] space-y-3">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-xl">📚</span>
        <div>
          <h1 class="text-base font-bold text-[var(--cin-fg-base)] leading-none">
            Artigos & Guias
          </h1>
          <p class="text-xs text-[var(--cin-fg-dim)] mt-0.5 mb-0">
            Conteúdos sobre frontend, arquitetura e engenharia
          </p>
        </div>
      </div>
      <span class="cin-badge text-xs flex-shrink-0" data-mobile-blog-count>
        {posts.length} {posts.length === 1 ? "artigo" : "artigos"}
      </span>
    </div>

    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[var(--cin-fg-dim)]">
        🔍
      </span>
      <input
        type="text"
        data-mobile-blog-search
        placeholder="Pesquisar artigos..."
        class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-[var(--cin-border)] bg-[var(--cin-bg-base)] text-[var(--cin-fg-base)] text-sm placeholder-[var(--cin-fg-dim)] focus:outline-none focus:border-[var(--cin-accent)] transition-colors"
      />
      <button
        type="button"
        data-mobile-blog-clear
        aria-label="Limpar pesquisa"
        class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs w-5 h-5 rounded-full bg-[var(--cin-bg-surface)] text-[var(--cin-fg-dim)] hover:text-[var(--cin-fg-base)] items-center justify-center border border-[var(--cin-border)] cursor-pointer"
      >
        ✕
      </button>
    </div>
  </div>

  <div
    data-mobile-blog-empty
    class:list={[
      "cin-box p-8 rounded-2xl bg-[var(--cin-bg-surface)] border border-[var(--cin-border)] text-center space-y-2",
      { hidden: posts.length > 0 },
    ]}
  >
    <span class="text-3xl block">🔍</span>
    <h2 class="text-sm font-bold text-[var(--cin-fg-base)] m-0">
      Nenhum artigo encontrado
    </h2>
    <p class="text-xs text-[var(--cin-fg-dim)] m-0">
      Tente pesquisar com outros termos ou limpe o filtro.
    </p>
    <button
      type="button"
      data-mobile-blog-reset
      class="cin-btn cin-btn-sm mt-3 cursor-pointer"
    >
      Limpar busca
    </button>
  </div>

  <div
    data-mobile-blog-grid
    class:list={[
      "grid grid-cols-1 md:grid-cols-2 gap-3.5",
      { hidden: posts.length === 0 },
    ]}
  >
    {
      posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          data-mobile-post-card
          data-search-text={`${post.title} ${post.description} ${post.id}`.toLowerCase()}
          class="cin-box p-4 sm:p-5 rounded-2xl bg-[var(--cin-bg-surface)] border border-[var(--cin-border)] hover:border-[var(--cin-accent)] hover:shadow-sm transition-all flex flex-col justify-between text-inherit no-underline group"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="cin-badge text-[11px] py-0.5 px-2.5">
                {post.pubDate}
              </span>
              <span class="text-[11px] font-mono text-[var(--cin-fg-dim)] truncate max-w-[120px]">
                {post.id}
              </span>
            </div>

            <h2 class="text-base font-bold text-[var(--cin-fg-base)] group-hover:text-[var(--cin-accent)] transition-colors line-clamp-2 mb-2 leading-snug">
              {post.title}
            </h2>

            <p class="text-xs sm:text-sm text-[var(--cin-fg-dim)] line-clamp-3 leading-relaxed m-0">
              {post.description}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--cin-separator)] flex items-center justify-between">
            <span class="text-xs font-semibold text-[var(--cin-accent)] group-hover:underline flex items-center gap-1">
              <span>Ler artigo</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
            <span class="text-[11px] text-[var(--cin-fg-dim)]">
              Publicação técnica
            </span>
          </div>
        </a>
      ))
    }
  </div>
</div>

<script>
  function initMobileBlogViews() {
    document.querySelectorAll<HTMLElement>("[data-mobile-blog-view]").forEach((root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const searchInput = root.querySelector<HTMLInputElement>("[data-mobile-blog-search]");
      const clearBtn = root.querySelector<HTMLButtonElement>("[data-mobile-blog-clear]");
      const resetBtn = root.querySelector<HTMLButtonElement>("[data-mobile-blog-reset]");
      const countBadge = root.querySelector<HTMLElement>("[data-mobile-blog-count]");
      const emptyBox = root.querySelector<HTMLElement>("[data-mobile-blog-empty]");
      const gridBox = root.querySelector<HTMLElement>("[data-mobile-blog-grid]");
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-mobile-post-card]"));

      const updateFilter = (query: string) => {
        const normalized = query.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          const text = card.dataset.searchText || "";
          const matches = !normalized || text.includes(normalized);
          card.classList.toggle("hidden", !matches);
          if (matches) visibleCount++;
        });

        if (clearBtn) {
          clearBtn.classList.toggle("hidden", !query);
          clearBtn.classList.toggle("flex", Boolean(query));
        }

        if (countBadge) {
          countBadge.textContent = `${visibleCount} ${visibleCount === 1 ? "artigo" : "artigos"}`;
        }

        if (emptyBox) {
          emptyBox.classList.toggle("hidden", visibleCount > 0);
        }

        if (gridBox) {
          gridBox.classList.toggle("hidden", visibleCount === 0);
        }
      };

      searchInput?.addEventListener("input", () => {
        updateFilter(searchInput.value);
      });

      const clearSearch = () => {
        if (searchInput) {
          searchInput.value = "";
          updateFilter("");
          searchInput.focus();
        }
      };

      clearBtn?.addEventListener("click", clearSearch);
      resetBtn?.addEventListener("click", clearSearch);
    });
  }

  initMobileBlogViews();
  document.addEventListener("astro:page-load", initMobileBlogViews);
</script>
